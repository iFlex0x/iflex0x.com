---
import Layout from "../layouts/Layout.astro";
import Z_Companion from "../components/Z_Companion.astro";

interface Z_Repo {
    name: string;
    html_url: string;
    description: string | null;
    fork: boolean;
    archived: boolean;
}

const Z_N = 3;
const Z_Url = "https://api.github.com/users/iFlex0x/repos?sort=pushed&per_page=10";
const Z_Token = import.meta.env.GITHUB_TOKEN;
const Z_Init = {
    headers: {
        "User-Agent": "iflex0x.com",
        Accept: "application/vnd.github.v3+json",
        ...(Z_Token ? { Authorization: `Bearer ${Z_Token}` } : {}),
    },
};

let Z_Projects: Z_Repo[] = [];
try {
    const Z_Res = await fetch(Z_Url, {
        ...Z_Init,
        signal: AbortSignal.timeout(8000),
    });
    if (Z_Res.ok) {
        const Z_Raw = (await Z_Res.json()) as unknown;
        const Z_All = Array.isArray(Z_Raw) ? (Z_Raw as Z_Repo[]) : [];
        Z_Projects = Z_All.filter((Z_R) => !Z_R.fork && !Z_R.archived).slice(0, Z_N);
    } else {
        console.warn(`projects: github -> ${Z_Res.status} ${Z_Res.statusText}`);
    }
} catch (Z_E) {
    console.warn("projects: fetch failed", Z_E);
}
