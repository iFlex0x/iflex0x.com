---
interface Props {
    mode?: "patrol" | "roam";
    anchorSelector?: string;
    fallbackBottom?: number;
}

const { mode = "patrol", anchorSelector = "footer", fallbackBottom = 48 } = Astro.props;
---

<div
    class="Z_Companion"
    aria-hidden="true"
    data-mode={mode}
    data-anchor={anchorSelector}
    data-fallback={fallbackBottom}
>
    <div class="Z_Pos">
        <div class="Z_Flip">
            <img
                class="Z_Sprite"
                src="https://media.iflex0x.com/rat.png"
                data-fallback="/rat.png"
                alt=""
                width="56"
                height="56"
                draggable="false"
            />
        </div>
    </div>
</div>

<style>
    .Z_Companion {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 40;
        overflow: hidden;
        pointer-events: none;
    }

    .Z_Pos {
        position: absolute;
        left: 0;
        top: 0;
        width: 56px;
        height: 56px;
        will-change: transform;
    }

    .Z_Flip {
        width: 56px;
        height: 56px;
        pointer-events: auto;
        cursor: pointer;
    }

    .Z_Sprite {
        display: block;
        width: 56px;
        height: 56px;
        object-fit: none;
        object-position: 0 0;
        image-rendering: pixelated;
    }
</style>

<script>
    const Z_Root = document.querySelector(".Z_Companion") as HTMLElement | null;
    if (Z_Root) {
        const Z_Roam = Z_Root.dataset.mode === "roam";
        const Z_Anchor = Z_Root.dataset.anchor ?? "footer";
        const Z_Fallback = Number(Z_Root.dataset.fallback ?? 48);
        const Z_Pos = Z_Root.querySelector(".Z_Pos") as HTMLElement;
        const Z_Flip = Z_Root.querySelector(".Z_Flip") as HTMLElement;
        const Z_Sprite = Z_Root.querySelector(".Z_Sprite") as HTMLImageElement;
        const Z_Size = 56;
        const Z_Flee = 130;
        const Z_Reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        const Z_S = {
            x: Math.min(240, Math.max(0, window.innerWidth - Z_Size)),
            y: Z_Roam ? window.innerHeight * 0.5 : 0,
            dirX: 1 as 1 | -1,
            dirY: 0,
            moving: false,
            fast: false,
            speed: 0,
            until: performance.now() + 1500,
            hop: 0,
            frame: 0,
            frameT: 0,
        };
        const Z_Mouse = { x: -9999, y: -9999 };
        let Z_Last = performance.now();

        window.addEventListener("pointermove", (Z_E) => {
            Z_Mouse.x = Z_E.clientX + window.scrollX;
            Z_Mouse.y = Z_E.clientY + window.scrollY;
        }, { passive: true });
        Z_Flip.addEventListener("click", () => {
            if (Z_S.hop <= 0) Z_S.hop = 1;
        });

        let Z_GroundBox: DOMRect | null = null;
        let Z_GroundAt = 0;

        const Z_Ground = () => {
            const Z_El = Z_Anchor ? document.querySelector(Z_Anchor) : null;
            if (Z_El) {
                if (!Z_GroundBox || performance.now() - Z_GroundAt > 2000) {
                    Z_GroundBox = Z_El.getBoundingClientRect();
                    Z_GroundAt = performance.now();
                }
                return Z_GroundBox.top + window.scrollY - Z_Size + 6;
            }
            return document.body.scrollHeight - Z_Fallback - Z_Size;
        };
        window.addEventListener("scroll", () => { Z_GroundBox = null; }, { passive: true });
        window.addEventListener("resize", () => { Z_GroundBox = null; });

        const Z_Tick = (Z_Now: number) => {
            const Z_Dt = Math.min(0.05, (Z_Now - Z_Last) / 1000);
            Z_Last = Z_Now;
            if (document.hidden) {
                requestAnimationFrame(Z_Tick);
                return;
            }

            const Z_MaxX = Math.max(0, window.innerWidth - Z_Size);
            const Z_MaxY = Math.max(0, window.innerHeight - Z_Size);
            const Z_Base = Z_Roam ? Z_S.y : Z_Ground();

            const Z_Cx = Z_S.x + Z_Size / 2;
            const Z_Cy = Z_Base + Z_Size / 2;
            const Z_Dx = Z_Cx - Z_Mouse.x;
            const Z_Dy = Z_Cy - Z_Mouse.y;
            const Z_Dist = Math.hypot(Z_Dx, Z_Dy);

            if (!Z_Reduced && Z_Dist < Z_Flee) {
                Z_S.moving = true;
                Z_S.fast = true;
                Z_S.speed = 260;
                Z_S.until = Z_Now + 400;
                Z_S.dirX = Z_Dx >= 0 ? 1 : -1;
                if (Z_Roam) Z_S.dirY = Z_Dy / (Z_Dist || 1);
            } else if (Z_Now > Z_S.until) {
                if (Z_Reduced || !Z_S.moving) {
                    Z_S.moving = Z_Reduced ? false : !Z_S.moving;
                    Z_S.fast = false;
                    Z_S.speed = Z_S.moving ? 50 + Math.random() * 30 : 0;
                    Z_S.until = Z_Now + 1500 + Math.random() * 2500;
                    if (Z_S.moving) {
                        if (Z_Roam) {
                            const Z_A = Math.random() * Math.PI * 2;
                            Z_S.dirX = Math.cos(Z_A) >= 0 ? 1 : -1;
                            Z_S.dirY = Math.sin(Z_A);
                        } else {
                            Z_S.dirX = Math.random() < 0.5 ? -1 : 1;
                        }
                    }
                } else {
                    Z_S.moving = false;
                    Z_S.speed = 0;
                    Z_S.until = Z_Now + 2000 + Math.random() * 3000;
                }
            }

            const Z_Mx = Z_Roam
                ? Math.abs(Math.cos(Math.asin(Math.max(-1, Math.min(1, Z_S.dirY)))))
                : 1;
            Z_S.x += Z_S.dirX * Z_Mx * Z_S.speed * Z_Dt;
            if (Z_Roam) Z_S.y += Z_S.dirY * Z_S.speed * Z_Dt;

            if (Z_S.x < 0 || Z_S.x > Z_MaxX) {
                Z_S.x = Math.min(Z_MaxX, Math.max(0, Z_S.x));
                Z_S.dirX = (Z_S.dirX * -1) as 1 | -1;
            }
            if (Z_Roam && (Z_S.y < 0 || Z_S.y > Z_MaxY)) {
                Z_S.y = Math.min(Z_MaxY, Math.max(0, Z_S.y));
                Z_S.dirY = -Z_S.dirY;
            }

            if (Z_S.moving && Z_S.speed > 0) {
                Z_S.frameT += Z_Dt * (Z_S.fast ? 14 : 8);
                if (Z_S.frameT >= 1) {
                    Z_S.frameT = 0;
                    Z_S.frame = (Z_S.frame + 1) % 4;
                }
            } else {
                Z_S.frame = 0;
            }

            let Z_Y = Z_Roam ? Z_S.y : Z_Base;
            if (Z_S.hop > 0) {
                Z_S.hop = Math.max(0, Z_S.hop - Z_Dt * 2.2);
                Z_Y -= Math.sin((1 - Z_S.hop) * Math.PI) * 34;
            }

            Z_Pos.style.transform = `translate3d(${Z_S.x}px, ${Z_Y}px, 0)`;
            Z_Flip.style.transform = `scaleX(${Z_S.dirX})`;
            Z_Sprite.style.objectPosition = `${-Z_S.frame * 56}px 0`;

            if (!Z_Reduced) requestAnimationFrame(Z_Tick);
        };
        Z_Pos.style.transform = `translate3d(${Z_S.x}px, ${Z_Roam ? Z_S.y : Z_Ground()}px, 0)`;
        if (!Z_Reduced) requestAnimationFrame(Z_Tick);
    }
</script>
